{
  "name": "uma-family-tree-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "wrangler": "wrangler",
    "deploy": "wrangler pages deploy .svelte-kit/cloudflare --project-name uma-family-tree-app",
    "build:deploy": "npm run build && npm run deploy",
    "db:schema:remote": "wrangler d1 execute uma-family-tree --remote --file=./db/schema.sql",
    "db:load:remote": "wrangler d1 execute uma-family-tree --remote --file=./db/pedigree.sql",
    "db:schema:local": "wrangler d1 execute uma-family-tree --local --file=./db/schema.sql",
    "db:load:local": "wrangler d1 execute uma-family-tree --local --file=./db/pedigree.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240000.0",
    "@sveltejs/adapter-cloudflare": "^4.7.0",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@types/three": "^0.185.0",
    "svelte": "^4.2.0",
    "svelte-check": "^3.6.0",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "wrangler": "^4.86.0"
  },
  "dependencies": {
    "3d-force-graph": "^1.73.0",
    "three": "^0.185.0"
  },
  "volta": {
    "node": "20.20.2"
  }
}
